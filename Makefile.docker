DIRS += $(shell find */* -maxdepth 0 -name Makefile -exec dirname "{}" \;)

# BUILD_TARGET selects where `make build` runs. `local` uses the
# local Docker daemon; any other value must name a kubectl context and builds
# inside that cluster as a Job rendered from hack/build-job.yaml.
# Unset BUILD_TARGET resolves automatically: a bounded `kubectl get --raw /readyz`
# probe through hack/cluster-alias.sh picks sun when it answers and the local
# daemon when it does not. An explicit BUILD_TARGET always wins and the probe is
# never run. SUN_PROBE=fail short-circuits the probe to "unreachable", so the
# fallback can be exercised without touching the cluster:
#   make -n build SUN_PROBE=fail
#
# The probe is cheap where sun is absent: with no sun kubeconfig on the host,
# kubectl fails immediately, so CI pays nothing. It costs the timeout only on a
# machine that holds the kubeconfig but cannot reach the cluster.
BUILD_TARGET_PROBE_TIMEOUT ?= 5
SUN_PROBE ?=

ifeq ($(origin BUILD_TARGET),undefined)
  ifeq ($(SUN_PROBE),fail)
    BUILD_TARGET := local
    BUILD_TARGET_REASON := sun unreachable: SUN_PROBE=fail
  else
    BUILD_TARGET_PROBE_OUT := $(shell BUILD_TARGET=sun bash -c 'source hack/cluster-alias.sh && kc --request-timeout=$(BUILD_TARGET_PROBE_TIMEOUT)s get --raw /readyz' 2>&1 | head -1)
    ifeq ($(BUILD_TARGET_PROBE_OUT),ok)
      BUILD_TARGET := sun
      BUILD_TARGET_REASON := probe ok
    else
      BUILD_TARGET := local
      BUILD_TARGET_REASON := sun unreachable: $(if $(BUILD_TARGET_PROBE_OUT),$(BUILD_TARGET_PROBE_OUT),probe produced no output)
    endif
  endif
  $(info build target: $(BUILD_TARGET) ($(BUILD_TARGET_REASON)))
else
  $(info build target: $(BUILD_TARGET) (explicit))
endif
BUILD_NAMESPACE ?= build
BUILD_TIMEOUT ?= 3600
BUILD_REPO_URL ?= https://github.com/$(IMAGE).git
BUILD_DOCKERFILE ?= Dockerfile
BUILD_PUSH_SECRET ?= buildkit-push

# What the Job clones. A release build must name the tag it claims to build: a
# Job that clones the default branch while tagging the image vX.Y.Z produces an
# image that matches no release and is reproducible from nothing.
REF ?= $(VERSION)

# A make value reaches the shell by textual substitution, and the shell re-expands $(…)
# and backticks even inside double quotes — so refusing only the quote characters is not
# enough: '$', '(', ')' and '`' are all legal in a git refname and all re-expand. This
# is evaluated at PARSE time, before any target, because a recipe-line guard runs too
# late: check-version-tag, upload and clean render the same values and would already
# have run. Any shell-active character in any of them refuses the whole invocation.
BUILD_VALUES = $(BUILD_TARGET)$(BUILD_NAMESPACE)$(BUILD_REPO_URL)$(REF)$(VERSION)$(BUILD_DOCKERFILE)$(DOCKER_REGISTRY)$(IMAGE)$(BUILD_PUSH_SECRET)$(BUILD_TIMEOUT)$(BRANCH)
SHELL_ACTIVE := ' " $$ ` \ ( ) ; & | < > ! *
# Scoped to the goals that render these values. REF and VERSION default to the current
# branch name and the newest tag, and an ordinary refname may legally contain '(' or
# '!', so an unscoped check would abort `make test` on a branch called feat/a(b).
# Evaluating at parse time still puts it ahead of every prerequisite, which a
# recipe-line guard does not — check-version-tag renders the same values and would
# already have run.
ifneq ($(filter build upload clean buca,$(MAKECMDGOALS)),)
ifneq ($(strip $(foreach c,$(SHELL_ACTIVE),$(findstring $(c),$(BUILD_VALUES)))),)
$(error a build value contains a shell metacharacter; refusing to build)
endif
endif

.PHONY: build
build: check-version-tag check-go-mod
	@if [ -z "$(VERSION)" ]; then echo "ERROR: no VERSION set and no git tag found — set VERSION=vX.Y.Z or create a tag" >&2; exit 1; fi
ifeq ($(BUILD_TARGET),local)
	DOCKER_BUILDKIT=1 \
	docker build \
	--pull \
	--no-cache \
	--rm=true \
	--platform=linux/amd64 \
	--build-arg DOCKER_REGISTRY="$(DOCKER_REGISTRY)" \
	--build-arg BUILD_GIT_VERSION=$$(git describe --tags --always --dirty) \
	--build-arg BUILD_GIT_COMMIT=$$(git rev-parse --short HEAD) \
	--build-arg BUILD_DATE=$$(date -u +%Y-%m-%dT%H:%M:%SZ) \
	-t "$(DOCKER_REGISTRY)/$(IMAGE):$(VERSION)" \
	-f "$(BUILD_DOCKERFILE)" .
else
	BUILD_TARGET='$(BUILD_TARGET)' \
	NAMESPACE='$(BUILD_NAMESPACE)' \
	REPO_URL='$(BUILD_REPO_URL)' \
	REF='$(REF)' \
	TAG='$(VERSION)' \
	DOCKERFILE='$(BUILD_DOCKERFILE)' \
	IMAGE='$(DOCKER_REGISTRY)/$(IMAGE)' \
	DOCKER_REGISTRY='$(DOCKER_REGISTRY)' \
	PUSH='true' \
	PUSH_SECRET='$(BUILD_PUSH_SECRET)' \
	TIMEOUT='$(BUILD_TIMEOUT)' \
	hack/build-cluster.sh
endif

.PHONY: check-version-tag
check-version-tag:
	@if [ -n "$(ALLOW_UNTAGGED_BUILD)" ]; then \
		echo "ALLOW_UNTAGGED_BUILD set — skipping version/tag check"; \
	else \
		head_tag=$$(git describe --tags --exact-match HEAD 2>/dev/null); \
		if [ "$$head_tag" != "$(VERSION)" ]; then \
			echo "ERROR: refusing to build $(VERSION) from this tree." >&2; \
			echo "  HEAD is at tag: $${head_tag:-<untagged>}" >&2; \
			echo "  building as:    $(VERSION)" >&2; \
			echo "  An image stamped vX.Y.Z must be built from the vX.Y.Z tag." >&2; \
			echo "  Fix: git checkout $(VERSION)   (or set ALLOW_UNTAGGED_BUILD=1 for a scratch build)" >&2; \
			exit 1; \
		fi; \
	fi

# The local arm needs vendor/ on disk before `docker build` copies the context.
# The remote arm does not: the Job clones a clean tree and the Dockerfile vendors
# inside the image. Running it anyway would need a local Go toolchain and network
# for a build that is supposed to need neither, and would leave vendor/ behind
# because `clean` is a no-op for remote targets.
.PHONY: check-go-mod
check-go-mod:
ifeq ($(BUILD_TARGET),local)
	@if [ -f "go.mod" ]; then \
		echo "go.mod found, running go mod vendor..."; \
		go mod vendor; \
	else \
		echo "go.mod not found, skipping go mod vendor."; \
	fi
endif

# A remote target pushes from inside the cluster and never loads the image on
# this machine, so there is nothing here to push and nothing to remove. Guard
# both, or `make buca BUILD_TARGET=<cluster>` fails at the push step after a
# build that actually succeeded — with "An image does not exist locally".
.PHONY: upload
upload:
ifeq ($(BUILD_TARGET),local)
	docker push "$(DOCKER_REGISTRY)/$(IMAGE):$(VERSION)"
endif

.PHONY: clean
clean:
ifeq ($(BUILD_TARGET),local)
	docker rmi "$(DOCKER_REGISTRY)/$(IMAGE):$(VERSION)" || true
	docker image prune -f || true
	docker builder prune --all -f || true
	rm -rf vendor
endif

.PHONY: apply
apply:
	@for i in $(DIRS); do \
		cd $$i; \
		echo "apply $${i}"; \
		make apply; \
		cd ..; \
	done

# Operator-run publish to Docker Hub (requires `docker login`). CI runs
# `make precommit`, never `buca`, so the unconditional push is safe. `apply` is a
# no-op placeholder (no k8s in this repo — deployment lives in the quant config
# repo as a Config CR). Shape mirrors bborbe/kafka-topic-reader.
.PHONY: buca
buca: build upload clean apply
