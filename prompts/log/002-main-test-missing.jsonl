{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_function_mvu839mif4f1_3","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\t// Command agent-code is the canonical pure-code agent reference.\n6\t//\n7\t// Demonstrates the agent framework working without any LLM dependency.\n8\t// Three phases (planning, in_progress, ai_review) each running a single\n9\t// pure-Go step. Useful template for orchestration agents, data agents,\n10\t// validation agents — anywhere the work is deterministic and AI is not\n11\t// needed.\n12\t//\n13\t// Kafka entry point — spawned as a K8s Job by task/executor with\n14\t// TASK_CONTENT + TASK_ID + PHASE + KAFKA_BROKERS env. For local CLI mode\n15\t// (file-based), see cmd/run-task/main.go.\n16\t//\n17\t// Reference implementation. Other pure-code agents copy this main.go and\n18\t// swap pkg/steps for their domain logic.\n19\tpackage main\n20\t\n21\timport (\n22\t\t\"context\"\n23\t\t\"os\"\n24\t\t\"os/signal\"\n25\t\t\"syscall\"\n26\t\t\"time\"\n27\t\n28\t\tagentlib \"github.com/bborbe/agent\"\n29\t\tdelivery \"github.com/bborbe/agent/delivery\"\n30\t\tlibmetrics \"github.com/bborbe/agent/metrics\"\n31\t\t\"github.com/bborbe/cqrs/base\"\n32\t\t\"github.com/bborbe/errors\"\n33\t\tlibkafka \"github.com/bborbe/kafka\"\n34\t\tlibsentry \"github.com/bborbe/sentry\"\n35\t\t\"github.com/bborbe/service\"\n36\t\tlibtime \"github.com/bborbe/time\"\n37\t\t\"github.com/bborbe/vault-cli/pkg/domain\"\n38\t\t\"github.com/golang/glog\"\n39\t\t\"github.com/prometheus/client_golang/prometheus\"\n40\t\t\"github.com/prometheus/client_golang/prometheus/push\"\n41\t\n42\t\t\"github.com/bborbe/agent-code/pkg/factory\"\n43\t)\n44\t\n45\tconst agentName = \"code-agent\"\n46\t\n47\tfunc main() {\n48\t\tctx, stop := signal.NotifyContext(context.Background(), syscall.SIGTERM, syscall.SIGINT)\n49\t\tdefer stop()\n50\t\tapp := &application{}\n51\t\tos.Exit(service.Main(ctx, app, &app.SentryDSN, &app.SentryProxy))\n52\t}\n53\t\n54\ttype application struct {\n55\t\tSentryDSN   string `required:\"false\" arg:\"sentry-dsn\"   env:\"SENTRY_DSN\"   usage:\"SentryDSN\"    display:\"length\"`\n56\t\tSentryProxy string `required:\"false\" arg:\"sentry-proxy\" env:\"SENTRY_PROXY\" usage:\"Sentry Proxy\"`\n57\t\n58\t\t// Task content from agent pipeline\n59\t\tTaskContent string `required:\"true\" arg:\"task-content\" env:\"TASK_CONTENT\" usage:\"Raw task markdown from vault\"`\n60\t\n61\t\t// Branch for Kafka result delivery\n62\t\tBranch base.Branch `required:\"false\" arg:\"branch\" env:\"BRANCH\" usage:\"branch\"`\n63\t\n64\t\t// TopicPrefix is an explicit Kafka topic prefix; empty means unprefixed topics.\n65\t\tTopicPrefix base.TopicPrefix `required:\"false\" arg:\"topic-prefix\" env:\"TOPIC_PREFIX\" usage:\"Explicit Kafka topic prefix; empty means unprefixed topics\"`\n66\t\n67\t\t// Phase to run (framework requires explicit phase)\n68\t\tPhase domain.TaskPhase `required:\"false\" arg:\"phase\" env:\"PHASE\" usage:\"Agent phase: planning | execution | ai_review\" default:\"planning\"`\n69\t\n70\t\t// Kafka delivery (optional — only active when TASK_ID is set)\n71\t\tKafkaBrokers libkafka.Brokers        `required:\"false\" arg:\"kafka-brokers\" env:\"KAFKA_BROKERS\" usage:\"Comma separated list of Kafka brokers\"`\n72\t\tTaskID       agentlib.TaskIdentifier `required:\"false\" arg:\"task-id\"       env:\"TASK_ID\"       usage:\"Agent task identifier for publishing results back to task controller\"`\n73\t\n74\t\tPushgatewayURL string `required:\"false\" arg:\"pushgateway-url\" env:\"PUSHGATEWAY_URL\" usage:\"Prometheus PushGateway URL\"          default:\"http://pushgateway:9090\"`\n75\t\tTaskType       string `required:\"false\" arg:\"task-type\"       env:\"TASK_TYPE\"       usage:\"Task type label for metric grouping\" default:\"unknown\"`\n76\t}\n77\t\n78\tfunc (a *application) Run(ctx context.Context, _ libsentry.Client) error {\n79\t\tregistry := prometheus.NewRegistry()\n80\t\tjobMetrics := libmetrics.NewJobMetrics(registry, libtime.NewCurrentDateTime())\n81\t\tpusher := push.New(a.PushgatewayURL, libmetrics.BuildJobMetricsName(agentName)).\n82\t\t\tGrouping(\"agent\", agentName).\n83\t\t\tGrouping(\"task_type\", a.TaskType).\n84\t\t\tCollector(registry)\n85\t\tdefer func() {\n86\t\t\tif err := pusher.PushContext(ctx); err != nil {\n87\t\t\t\tglog.Warningf(\"prometheus push failed: %v\", err)\n88\t\t\t\treturn\n89\t\t\t}\n90\t\t\tglog.V(2).Infof(\"prometheus push completed\")\n91\t\t}()\n92\t\tstart := libtime.NewCurrentDateTime().Now().Time()\n93\t\n94\t\tglog.V(2).Infof(\"agent-code started phase=%s\", a.Phase)\n95\t\n96\t\tdeliverer := delivery.NewNoopResultDeliverer()\n97\t\tif a.TaskID != \"\" {\n98\t\t\tif len(a.KafkaBrokers) == 0 {\n99\t\t\t\tjobMetrics.RecordRun(agentlib.AgentStatusFailed)\n100\t\t\t\tjobMetrics.RecordDuration(time.Since(start))\n101\t\t\t\treturn errors.Errorf(ctx, \"KAFKA_BROKERS must be set when TASK_ID is set\")\n102\t\t\t}\n103\t\t\tsyncProducer, err := libkafka.NewSyncProducerWithName(ctx, a.KafkaBrokers, agentName)\n104\t\t\tif err != nil {\n105\t\t\t\tjobMetrics.RecordRun(agentlib.AgentStatusFailed)\n106\t\t\t\tjobMetrics.RecordDuration(time.Since(start))\n107\t\t\t\treturn errors.Wrap(ctx, err, \"create sync producer\")\n108\t\t\t}\n109\t\t\tdefer func() {\n110\t\t\t\tif err := syncProducer.Close(); err != nil {\n111\t\t\t\t\tglog.Warningf(\"close sync producer failed: %v\", err)\n112\t\t\t\t}\n113\t\t\t}()\n114\t\t\tdeliverer = factory.CreateKafkaResultDeliverer(\n115\t\t\t\tsyncProducer, a.TopicPrefix, a.TaskID, a.TaskContent,\n116\t\t\t\tlibtime.NewCurrentDateTime(),\n117\t\t\t)\n118\t\t}\n119\t\n120\t\tprovider := factory.CreateAgentProvider()\n121\t\tagent, err := provider.Get(ctx, agentlib.TaskType(a.TaskType))\n122\t\tif err != nil {\n123\t\t\tjobMetrics.RecordRun(a