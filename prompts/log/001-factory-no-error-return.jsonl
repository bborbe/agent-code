.SIGINT)\n49\t\tdefer stop()\n50\t\tapp := &application{}\n51\t\tos.Exit(service.Main(ctx, app, &app.SentryDSN, &app.SentryProxy))\n52\t}\n53\t\n54\ttype application struct {\n55\t\tSentryDSN   string `required:\"false\" arg:\"sentry-dsn\"   env:\"SENTRY_DSN\"   usage:\"SentryDSN\"    display:\"length\"`\n56\t\tSentryProxy string `required:\"false\" arg:\"sentry-proxy\" env:\"SENTRY_PROXY\" usage:\"Sentry Proxy\"`\n57\t\n58\t\t// Task content from agent pipeline\n59\t\tTaskContent string `required:\"true\" arg:\"task-content\" env:\"TASK_CONTENT\" usage:\"Raw task markdown from vault\"`\n60\t\n61\t\t// Branch for Kafka result delivery\n62\t\tBranch base.Branch `required:\"false\" arg:\"branch\" env:\"BRANCH\" usage:\"branch\"`\n63\t\n64\t\t// TopicPrefix is an explicit Kafka topic prefix; empty means unprefixed topics.\n65\t\tTopicPrefix base.TopicPrefix `required:\"false\" arg:\"topic-prefix\" env:\"TOPIC_PREFIX\" usage:\"Explicit Kafka topic prefix; empty means unprefixed topics\"`\n66\t\n67\t\t// Phase to run (framework requires explicit phase)\n68\t\tPhase domain.TaskPhase `required:\"false\" arg:\"phase\" env:\"PHASE\" usage:\"Agent phase: planning | execution | ai_review\" default:\"planning\"`\n69\t\n70\t\t// Kafka delivery (optional — only active when TASK_ID is set)\n71\t\tKafkaBrokers libkafka.Brokers        `required:\"false\" arg:\"kafka-brokers\" env:\"KAFKA_BROKERS\" usage:\"Comma separated list of Kafka brokers\"`\n72\t\tTaskID       agentlib.TaskIdentifier `required:\"false\" arg:\"task-id\"       env:\"TASK_ID\"       usage:\"Agent task identifier for publishing results back to task controller\"`\n73\t\n74\t\tPushgatewayURL string `required:\"false\" arg:\"pushgateway-url\" env:\"PUSHGATEWAY_URL\" usage:\"Prometheus PushGateway URL\"          default:\"http://pushgateway:9090\"`\n75\t\tTaskType       string `required:\"false\" arg:\"task-type\"       env:\"TASK_TYPE\"       usage:\"Task type label for metric grouping\" default:\"unknown\"`\n76\t}\n7